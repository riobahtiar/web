---
import { render } from "astro:content";

import { getPostSlug, getPublishedPosts } from "@/utils/posts";
import BlogPost from "../../../../layouts/BlogPost.astro";
import { getReadingTimeI18n } from "../../../../utils/readingTime";
import { getRelatedPostsWithReadingTime } from "../../../../utils/relatedPosts";
import RelatedPosts from "../../../../components/blog/RelatedPosts.astro";

const { category, slug } = Astro.params;

const posts = await getPublishedPosts("blog-id");
const post = posts.find(
  (p) => p.data.category === category && getPostSlug(p) === slug,
);

if (!post) {
  return new Response(null, { status: 404 });
}

const { Content, headings } = await render(post);
const readingTime = getReadingTimeI18n(post.body ?? "", "id");

// Get related posts
const relatedPosts = await getRelatedPostsWithReadingTime(post, posts, 3, "id");
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  created_at={post.data.created_at}
  modified_at={post.data.modified_at}
  image={post.data.image}
  category={post.data.category}
  tags={post.data.tags}
  author={post.data.author}
  readingTime={readingTime}
  headings={headings}
  lang="id"
>
  <Content />

  <RelatedPosts posts={relatedPosts} lang="id" />
</BlogPost>
