---
import BlogIndex from "@/layouts/BlogIndex.astro";
import { getCategoryCounts, getPublishedPosts } from "@/utils/posts";

const { category } = Astro.params;

const allPosts = await getPublishedPosts("blog-id");
const posts = allPosts.filter((post) => post.data.category === category);

// Kategori tak dikenal akan merender halaman kosong yang terindeks.
if (posts.length === 0) {
  return Astro.redirect("/id/blog");
}

const title = `Kategori: ${category}`;
const description = `Jelajahi semua artikel dalam kategori ${category}`;
---

<BlogIndex
  title={title}
  description={description}
  lang="id"
  posts={posts}
  categories={getCategoryCounts(allPosts)}
  currentCategory={category}
  localized={false}
/>
