---
import BlogIndex from "@/layouts/BlogIndex.astro";
import {
  getCategoryCounts,
  getPublishedPosts,
  paginatePosts,
} from "@/utils/posts";

const allPosts = await getPublishedPosts("blog-id");
const { posts, pagination } = paginatePosts(allPosts, 1, "/id/blog");

const title = "Blog";
const description =
  "Jelajahi pemikiran, pengalaman, dan wawasan saya tentang pengembangan perangkat lunak, teknologi, dan lainnya.";
---

<BlogIndex
  title={title}
  description={description}
  lang="id"
  posts={posts}
  allPosts={allPosts}
  categories={getCategoryCounts(allPosts)}
  pagination={pagination}
/>
