---
import BlogIndex from "@/layouts/BlogIndex.astro";
import {
  getCategoryCounts,
  getPublishedPosts,
  paginatePosts,
  parsePageParam,
} from "@/utils/posts";

const requestedPage = parsePageParam(Astro.params.page);

const allPosts = await getPublishedPosts("blog-id");
const { posts, pagination } = paginatePosts(
  allPosts,
  requestedPage,
  "/id/blog",
);

// Page 1 is permanently canonical at /id/blog.
if (requestedPage === 1) {
  return Astro.redirect("/id/blog", 301);
}

// Past the last page there is nothing to show yet, but more posts may fill it
// in later, so this stays a temporary redirect.
if (requestedPage > pagination.totalPages) {
  return Astro.redirect("/id/blog");
}

const title = `Blog — Halaman ${pagination.currentPage}`;
const description =
  "Jelajahi pemikiran, pengalaman, dan wawasan saya tentang pengembangan perangkat lunak, teknologi, dan lainnya.";
---

<BlogIndex
  title={title}
  description={description}
  lang="id"
  posts={posts}
  allPosts={allPosts}
  categories={getCategoryCounts(allPosts)}
  pagination={pagination}
/>
