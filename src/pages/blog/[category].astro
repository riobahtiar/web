---
import BlogIndex from "@/layouts/BlogIndex.astro";
import { getCategoryCounts, getPublishedPosts } from "@/utils/posts";

const { category } = Astro.params;

const allPosts = await getPublishedPosts("blog-en");
const posts = allPosts.filter((post) => post.data.category === category);

// An unknown category would otherwise render an empty, indexable page.
if (posts.length === 0) {
  return Astro.redirect("/blog");
}

const title = `Category: ${category}`;
const description = `Browse all posts in the ${category} category`;
---

<BlogIndex
  title={title}
  description={description}
  lang="en"
  posts={posts}
  categories={getCategoryCounts(allPosts)}
  currentCategory={category}
/>
