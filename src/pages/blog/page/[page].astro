---
import BlogIndex from "@/layouts/BlogIndex.astro";
import {
  getCategoryCounts,
  getPublishedPosts,
  paginatePosts,
  parsePageParam,
} from "@/utils/posts";

const requestedPage = parsePageParam(Astro.params.page);

const allPosts = await getPublishedPosts("blog-en");
const { posts, pagination } = paginatePosts(allPosts, requestedPage, "/blog");

// Page 1 is permanently canonical at /blog.
if (requestedPage === 1) {
  return Astro.redirect("/blog", 301);
}

// Past the last page there is nothing to show yet, but more posts may fill it
// in later, so this stays a temporary redirect.
if (requestedPage > pagination.totalPages) {
  return Astro.redirect("/blog");
}

const title = `Blog — Page ${pagination.currentPage}`;
const description =
  "Explore my thoughts, experiences, and insights on software development, technology, and more.";
---

<BlogIndex
  title={title}
  description={description}
  lang="en"
  posts={posts}
  allPosts={allPosts}
  categories={getCategoryCounts(allPosts)}
  pagination={pagination}
/>
