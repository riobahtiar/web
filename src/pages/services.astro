---
import WorkComponent from "../components/Work.astro";
import Layout from "../layouts/Layout.astro";
import { en } from "../i18n/en";

// Set the current language for the page
const lang = "en";
---

<Layout lang={lang} title={en.work.title} description={en.work.description}>
  <WorkComponent lang={lang} i18n={en} />
</Layout>
