---
import type { Pagination } from "@/utils/posts";

import Layout from "./Layout.astro";
import BlogSearch from "../components/blog/BlogSearch";

interface BlogPost {
  id: string;
  data: {
    title: string;
    description: string;
    created_at: Date;
    image?: string;
    category: string;
    tags: string[];
    author: {
      name: string;
      image: string;
    };
  };
}

interface Props {
  title: string;
  description: string;
  lang: string;
  posts: BlogPost[];
  /** The full archive, so client-side search is not limited to this page. */
  allPosts?: BlogPost[];
  categories?: { name: string; count: number }[];
  currentCategory?: string;
  pagination?: Pagination;
}

const {
  title,
  description,
  lang,
  posts,
  allPosts,
  categories,
  currentCategory,
  pagination = { currentPage: 1, totalPages: 1, url: {} },
} = Astro.props;

const baseUrl = `/${lang === "en" ? "" : "id/"}blog`;
---

<Layout title={title} description={description} lang={lang}>
  <div class="px-6 py-16 sm:px-10">
    <main>
      <div class="flex flex-col gap-12 lg:flex-row">
        <!-- Main Content -->
        <div class="min-w-0 flex-1">
          <header class="mb-10">
            <h1 class="text-4xl font-semibold sm:text-5xl">{title}</h1>
            <p class="text-muted-foreground mt-4 max-w-2xl text-lg text-pretty">
              {description}
            </p>
          </header>

          <!-- Search and Posts -->
          <BlogSearch
            posts={posts}
            allPosts={allPosts ?? posts}
            lang={lang}
            baseUrl={baseUrl}
            pagination={pagination}
            client:load
          />
        </div>

        <!-- Sidebar -->
        <aside class="space-y-8 lg:w-72">
          <!-- Categories -->
          {
            categories && (
              <div class="border-border bg-surface rounded-xl border p-6">
                <p class="eyebrow">
                  {lang === "en" ? "Categories" : "Kategori"}
                </p>
                <ul class="mt-4 space-y-2" role="list">
                  <li>
                    <a
                      href={baseUrl}
                      class={`hover:text-foreground block text-sm transition-colors ${!currentCategory ? "text-accent" : "text-muted-foreground"}`}
                    >
                      {lang === "en" ? "All Posts" : "Semua Artikel"}
                    </a>
                  </li>
                  {categories.map((category) => (
                    <li>
                      <a
                        href={`${baseUrl}/${category.name}`}
                        class={`hover:text-foreground block text-sm transition-colors ${currentCategory === category.name ? "text-accent" : "text-muted-foreground"}`}
                      >
                        {category.name}
                        <span class="text-subtle-foreground">
                          {" "}
                          ({category.count})
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </main>
  </div>
</Layout>
