---
import type { Pagination } from "@/utils/posts";

import { formatDate } from "@/utils/date";

interface BlogPost {
  id: string;
  data: {
    title: string;
    description: string;
    created_at: Date;
    image?: string;
    category: string;
    tags: string[];
    author: { name: string; image: string };
  };
}

interface Props {
  /** Posts on the current page. */
  posts: BlogPost[];
  /** The whole archive, so search is not limited to the current page. */
  allPosts?: BlogPost[];
  lang: string;
  baseUrl: string;
  pagination?: Pagination;
}

const { posts, allPosts, lang, baseUrl, pagination } = Astro.props;

const id = lang === "id";
const archive = allPosts ?? posts;
const onPage = new Set(posts.map((post) => post.id));

const slugOf = (post: BlogPost) => {
  const prefix = `${post.data.category}/`;
  return post.id.startsWith(prefix) ? post.id.slice(prefix.length) : post.id;
};

/** Everything the client-side filter matches against, lowercased once here. */
const haystack = (post: BlogPost) =>
  [
    post.data.title,
    post.data.description,
    post.data.category,
    ...post.data.tags,
  ]
    .join(" ")
    .toLowerCase();

const t = {
  placeholder: id
    ? "Cari artikel berdasarkan judul, kategori, atau tag..."
    : "Search articles by title, category, or tag...",
  clear: id ? "Hapus pencarian" : "Clear search",
  empty: id ? "Tidak ada artikel yang ditemukan." : "No articles found.",
  prev: id ? "Sebelumnya" : "Previous",
  next: id ? "Selanjutnya" : "Next",
};
---

<div
  class="w-full"
  data-blog-search
  data-showing-id={id
    ? "Menampilkan {n} dari {total} artikel"
    : "Showing {n} of {total} articles"}
>
  <div class="mb-10">
    <div class="relative">
      <svg
        class="text-subtle-foreground pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="search"
        data-search-input
        placeholder={t.placeholder}
        aria-label={t.placeholder}
        class="border-border bg-surface text-foreground placeholder:text-subtle-foreground focus:border-border-strong h-11 w-full rounded-lg border pr-4 pl-11 text-sm transition-colors outline-none"
      />
    </div>
    <p class="text-muted-foreground mt-2 text-sm" data-search-count hidden></p>
  </div>

  <div class="grid gap-12" data-post-list>
    {
      archive.map((post) => (
        <article
          class="grid gap-6 md:grid-cols-3"
          data-post
          data-haystack={haystack(post)}
          data-on-page={onPage.has(post.id) ? "true" : "false"}
          hidden={!onPage.has(post.id)}
        >
          {post.data.image && (
            <a
              href={`${baseUrl}/${post.data.category}/${slugOf(post)}`}
              class="block md:col-span-1"
              tabindex="-1"
              aria-hidden="true"
            >
              <div class="border-border aspect-[16/9] overflow-hidden rounded-xl border">
                <img
                  src={post.data.image}
                  alt=""
                  width="400"
                  height="225"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.03]"
                />
              </div>
            </a>
          )}

          <div class={post.data.image ? "md:col-span-2" : "md:col-span-3"}>
            <div class="text-muted-foreground mb-2 flex items-center gap-3 text-sm">
              <a
                href={`${baseUrl}/${post.data.category}`}
                class="hover:text-foreground transition-colors"
              >
                {post.data.category}
              </a>
              <span class="text-subtle-foreground" aria-hidden="true">
                •
              </span>
              <time datetime={new Date(post.data.created_at).toISOString()}>
                {formatDate(post.data.created_at, lang)}
              </time>
            </div>

            <h2 class="text-2xl font-semibold">
              <a
                href={`${baseUrl}/${post.data.category}/${slugOf(post)}`}
                class="hover:text-accent transition-colors"
              >
                {post.data.title}
              </a>
            </h2>

            <p class="text-muted-foreground mt-2 line-clamp-2 text-pretty">
              {post.data.description}
            </p>

            <div class="mt-4 flex items-center gap-2.5">
              <img
                src={post.data.author.image}
                alt=""
                width="24"
                height="24"
                loading="lazy"
                class="border-border h-6 w-6 rounded-full border"
              />
              <span class="text-muted-foreground text-sm">
                {post.data.author.name}
              </span>
            </div>

            {post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <a
                    href={`${baseUrl}/tag/${tag}`}
                    class="border-border text-muted-foreground hover:border-border-strong hover:text-foreground rounded-md border px-2 py-0.5 text-xs transition-colors"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="py-12 text-center" data-empty-state hidden>
    <p class="text-muted-foreground">{t.empty}</p>
    <button
      type="button"
      data-clear-search
      class="border-border-strong bg-surface text-foreground hover:bg-surface-hover mt-4 inline-flex h-9 items-center rounded-lg border px-4 text-sm font-medium transition-colors"
    >
      {t.clear}
    </button>
  </div>

  {
    pagination && pagination.totalPages > 1 && (
      <div class="mt-14 flex justify-center gap-2" data-pagination>
        {pagination.url.prev && (
          <a
            href={pagination.url.prev}
            class="border-border text-muted-foreground hover:text-foreground hover:bg-surface-2 inline-flex h-9 items-center rounded-lg border px-3 text-sm transition-colors"
          >
            ← {t.prev}
          </a>
        )}
        <span class="text-subtle-foreground inline-flex h-9 items-center px-3 font-mono text-sm">
          {pagination.currentPage} / {pagination.totalPages}
        </span>
        {pagination.url.next && (
          <a
            href={pagination.url.next}
            class="border-border text-muted-foreground hover:text-foreground hover:bg-surface-2 inline-flex h-9 items-center rounded-lg border px-3 text-sm transition-colors"
          >
            {t.next} →
          </a>
        )}
      </div>
    )
  }
</div>

<script>
  function setupBlogSearch() {
    const root = document.querySelector<HTMLElement>("[data-blog-search]");
    if (!root) return;

    const input = root.querySelector<HTMLInputElement>("[data-search-input]");
    const posts = [...root.querySelectorAll<HTMLElement>("[data-post]")];
    const count = root.querySelector<HTMLElement>("[data-search-count]");
    const empty = root.querySelector<HTMLElement>("[data-empty-state]");
    const pagination = root.querySelector<HTMLElement>("[data-pagination]");
    const template = root.dataset.showingId ?? "Showing {n} of {total}";
    if (!input) return;

    function apply() {
      const query = input!.value.trim().toLowerCase();
      let shown = 0;

      for (const post of posts) {
        // With no query the server-rendered page slice stands; a query
        // searches the whole archive.
        const visible = query
          ? (post.dataset.haystack ?? "").includes(query)
          : post.dataset.onPage === "true";
        post.hidden = !visible;
        if (visible) shown++;
      }

      if (count) {
        count.hidden = !query;
        count.textContent = template
          .replace("{n}", String(shown))
          .replace("{total}", String(posts.length));
      }
      if (empty) empty.hidden = shown > 0;
      // Paging through filtered results would be misleading.
      if (pagination) pagination.hidden = Boolean(query);
    }

    input.addEventListener("input", apply);
    root.querySelector("[data-clear-search]")?.addEventListener("click", () => {
      input.value = "";
      apply();
      input.focus();
    });
  }

  setupBlogSearch();
  document.addEventListener("astro:page-load", setupBlogSearch);
</script>
