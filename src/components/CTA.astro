---
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";

interface Props {
  lang: string;
  i18n: {
    work: {
      title: string;
      subtitle: string;
      description: string;
      cta: {
        viewServices: string;
        consultation: string;
      };
    };
  };
}

const { lang, i18n } = Astro.props;
const prefix = lang === "en" ? "" : "id/";
---

<Section class="py-20">
  <div
    class="border-border bg-surface relative overflow-hidden rounded-2xl border px-6 py-14 text-center sm:px-14"
  >
    <div class="accent-glow pointer-events-none absolute inset-0"></div>

    <div class="relative">
      <p class="eyebrow">{i18n.work.subtitle}</p>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
        {i18n.work.title}
      </h2>
      <p
        class="text-muted-foreground mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-pretty"
      >
        {i18n.work.description}
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href={`/${prefix}services`} size="lg">
          {i18n.work.cta.viewServices}
        </Button>
        <Button
          href={`/${prefix}contact?type=consultation`}
          variant="secondary"
          size="lg"
        >
          {i18n.work.cta.consultation}
        </Button>
      </div>
    </div>
  </div>
</Section>
