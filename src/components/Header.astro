---
import { Icon } from "astro-icon/components";

import Logo from "./Logo.astro";

interface Props {
  lang: string;
  /** Computed by Layout, which knows whether this URL exists in both locales. */
  languageUrl: string;
  i18n: {
    nav: {
      home: string;
      about: string;
      projects: string;
      contact: string;
      work: string;
      blog: string;
      comingSoon: string;
    };
    footer: {
      darkMode: string;
    };
  };
}

const { lang, i18n, languageUrl } = Astro.props;

const currentPath = new URL(Astro.request.url).pathname;
const alternateLanguage = lang === "en" ? "Bahasa Indonesia" : "English";
const prefix = lang === "en" ? "" : "id/";
const homeUrl = lang === "en" ? "/" : "/id/";

const links = [
  { href: `/${prefix}about`, label: i18n.nav.about },
  { href: lang === "en" ? "/services" : "/id/services", label: i18n.nav.work },
  { href: `/${prefix}blog`, label: i18n.nav.blog },
  { href: `/${prefix}contact`, label: i18n.nav.contact },
];

const isActive = (path: string) =>
  path === homeUrl ? currentPath === homeUrl : currentPath.startsWith(path);
---

<header
  id="main-header"
  class="bg-background/80 border-rule fixed top-0 right-0 left-0 z-40 border-b backdrop-blur-md"
>
  <div class="frame flex h-16 items-center gap-6 px-6 sm:px-10">
    <a
      href={homeUrl}
      class="shrink-0 transition-opacity hover:opacity-70"
      aria-label="Rio Bahtiar"
    >
      <Logo class="h-7 w-auto" width="58" height="32" />
    </a>

    <nav class="hidden flex-1 items-center gap-1 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-1.5 text-sm transition-colors",
              isActive(link.href)
                ? "text-foreground bg-surface-2 font-medium"
                : "text-muted-foreground hover:text-foreground hover:bg-surface-2",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <a
        href={languageUrl}
        class="text-muted-foreground hover:text-foreground hover:bg-surface-2 inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm transition-colors"
        title={alternateLanguage}
      >
        <Icon name="tabler:language" class="h-4 w-4" />
        <span class="font-mono text-xs tracking-wider uppercase">
          {lang === "en" ? "EN" : "ID"}
        </span>
      </a>

      <button
        type="button"
        id="theme-toggle"
        class="text-muted-foreground hover:text-foreground hover:bg-surface-2 inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors"
        aria-label={i18n.footer.darkMode}
      >
        <Icon name="tabler:sun" class="theme-icon-light h-[18px] w-[18px]" />
        <Icon name="tabler:moon" class="theme-icon-dark h-[18px] w-[18px]" />
      </button>

      <button
        type="button"
        id="mobile-menu-button"
        class="text-muted-foreground hover:text-foreground hover:bg-surface-2 inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors lg:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="tabler:menu-2" class="h-[18px] w-[18px]" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="border-rule bg-background border-b lg:hidden"
    hidden
  >
    <nav class="frame flex flex-col px-6 py-3 sm:px-10">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-md px-3 py-2.5 text-sm transition-colors",
              isActive(link.href)
                ? "text-foreground bg-surface-2 font-medium"
                : "text-muted-foreground hover:text-foreground hover:bg-surface-2",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<div class="h-16" aria-hidden="true"></div>

<script>
  function setupHeader() {
    const toggle = document.getElementById("theme-toggle");
    toggle?.addEventListener("click", () => {
      const root = document.documentElement;
      const next =
        root.getAttribute("data-theme") === "dark" ? "light" : "dark";

      root.setAttribute("data-theme", next);
      root.classList.toggle("dark", next === "dark");
      localStorage.setItem("theme", next);
    });

    const menuButton = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    menuButton?.addEventListener("click", () => {
      const open = menu?.hasAttribute("hidden");
      if (open) {
        menu?.removeAttribute("hidden");
      } else {
        menu?.setAttribute("hidden", "");
      }
      menuButton.setAttribute("aria-expanded", String(open));
    });
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
