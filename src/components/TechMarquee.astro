---
import { Icon } from "astro-icon/components";

import { stack } from "@/i18n/technology";

interface Props {
  label: string;
  /** Lower is faster. Scales with the item count so the pace stays even. */
  secondsPerItem?: number;
}

const { label, secondsPerItem = 2.6 } = Astro.props;
const duration = `${(stack.length * secondsPerItem).toFixed(0)}s`;
---

<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-8">
  <p class="eyebrow shrink-0">{label}</p>

  <div class="marquee min-w-0 flex-1" style={`--duration: ${duration}`}>
    <div class="marquee__track">
      {
        [false, true].map((isClone) => (
          <ul
            class="marquee__group"
            role={isClone ? "presentation" : "list"}
            aria-hidden={isClone ? "true" : undefined}
            aria-label={isClone ? undefined : label}
          >
            {stack.map((tech) => (
              <li class="marquee__item">
                <Icon name={tech.icon} class="h-[18px] w-[18px] shrink-0" />
                <span>{tech.name}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    /* Fade the ends so items enter and leave instead of being cut off. */
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 4rem,
      #000 calc(100% - 4rem),
      transparent
    );
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll var(--duration, 45s) linear infinite;
  }

  /* Let people stop it to read a name. */
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    padding-right: 2.25rem;
    margin: 0;
    list-style: none;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted-foreground);
    transition: color 150ms;
  }

  .marquee__item:hover {
    color: var(--foreground);
  }

  @keyframes marquee-scroll {
    /* The track is exactly two copies, so one group width is 50%. */
    to {
      transform: translateX(-50%);
    }
  }

  /* No motion: a plain wrapped list, and the duplicate is dropped entirely. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }

    .marquee__track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
    }

    .marquee__group[aria-hidden="true"] {
      display: none;
    }

    .marquee__group {
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      padding-right: 0;
    }
  }
</style>
