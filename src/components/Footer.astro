---
import { Icon } from "astro-icon/components";

import Button from "@/components/ui/Button.astro";

interface Props {
  lang?: string;
  i18n?: {
    nav: {
      home: string;
      about: string;
      work: string;
      blog: string;
      contact: string;
    };
    footer: {
      allRightsReserved: string;
    };
  };
}

const { lang = "en", i18n } = Astro.props;
const id = lang === "id";
const currentYear = new Date().getFullYear();

const prefix = id ? "id/" : "";
const homeUrl = id ? "/id/" : "/";
const servicesUrl = id ? "/id/services" : "/services";
const contactUrl = `/${prefix}contact`;

const columns = [
  {
    title: id ? "Tautan Cepat" : "Quick Links",
    links: [
      { href: homeUrl, label: i18n?.nav.home ?? (id ? "Beranda" : "Home") },
      {
        href: `/${prefix}about`,
        label: i18n?.nav.about ?? (id ? "Tentang" : "About"),
      },
      { href: `/${prefix}portfolio`, label: "Portfolio" },
      { href: `/${prefix}blog`, label: i18n?.nav.blog ?? "Blog" },
    ],
  },
  {
    title: id ? "Layanan" : "Services",
    links: [
      {
        href: servicesUrl,
        label: id ? "Konsultasi Teknis" : "Technical Consultation",
      },
      {
        href: servicesUrl,
        label: id ? "Pengembangan Website" : "Website Development",
      },
      { href: servicesUrl, label: id ? "Desain Sistem" : "System Design" },
      { href: servicesUrl, label: "SEO & Marketing" },
    ],
  },
];

const socials = [
  {
    href: "https://go.rio.my.id/g",
    icon: "tabler:brand-github",
    label: "GitHub",
  },
  {
    href: "https://go.rio.my.id/l",
    icon: "tabler:brand-linkedin",
    label: "LinkedIn",
  },
  { href: "https://go.rio.my.id/x", icon: "tabler:brand-x", label: "X" },
];
---

<footer class="rule-t">
  <div class="frame px-6 py-14 sm:px-10">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <p class="text-base font-semibold">Rio Bahtiar</p>
        <p class="text-muted-foreground mt-2 max-w-xs text-sm">
          {
            id
              ? "Software Engineer & Konsultan Teknologi"
              : "Software Engineer & Tech Consultant"
          }
        </p>
        <div class="mt-5 flex gap-1">
          {
            socials.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground hover:text-foreground hover:bg-surface-2 inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors"
              >
                <Icon name={social.icon} class="h-[18px] w-[18px]" />
              </a>
            ))
          }
        </div>
      </div>

      {
        columns.map((column) => (
          <nav>
            <p class="eyebrow">{column.title}</p>
            <ul class="mt-4 space-y-2.5" role="list">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <p class="eyebrow">{id ? "Kontak" : "Contact"}</p>
        <ul class="mt-4 space-y-2.5" role="list">
          <li>
            <a
              href="mailto:hello@rio.my.id"
              class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors"
            >
              <Icon name="tabler:mail" class="h-4 w-4" />
              hello@rio.my.id
            </a>
          </li>
          <li
            class="text-muted-foreground inline-flex items-center gap-2 text-sm"
          >
            <Icon name="tabler:map-pin" class="h-4 w-4" />
            Indonesia
          </li>
        </ul>
        <Button href={contactUrl} variant="secondary" size="sm" class="mt-5">
          {id ? "Hubungi Saya" : "Contact Me"}
        </Button>
      </div>
    </div>

    <div
      class="border-rule mt-12 flex flex-col items-center justify-between gap-3 border-t pt-6 sm:flex-row"
    >
      <p class="text-subtle-foreground text-sm">
        © {currentYear} Rio Bahtiar. {
          i18n?.footer.allRightsReserved ?? "All rights reserved."
        }
      </p>
      <div class="flex gap-6">
        <a
          href={`/${prefix}privacy`}
          class="text-subtle-foreground hover:text-foreground text-sm transition-colors"
        >
          {id ? "Kebijakan Privasi" : "Privacy Policy"}
        </a>
        <a
          href={`/${prefix}terms`}
          class="text-subtle-foreground hover:text-foreground text-sm transition-colors"
        >
          {id ? "Syarat & Ketentuan" : "Terms of Service"}
        </a>
      </div>
    </div>
  </div>
</footer>
