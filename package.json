{
  "name": "astro-rio",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "astro dev stop || true && rm -rf node_modules/.vite .astro/cache && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "bun run build && wrangler deploy",
    "astro": "astro",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.0.2",
    "@iconify-json/tabler": "^1.2.38",
    "@kobalte/core": "^0.13.13",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "astro-icon": "^1.2.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.27",
    "lucide-solid": "^1.39.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.128.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "workerd"
  ]
}
